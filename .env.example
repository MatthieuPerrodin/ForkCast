# Copy this file to `.env` (never committed) and adjust the values.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Leave empty locally (falls back to SQLite automatically).
# In production, the Supabase (Postgres) connection URL -- see docs/03-tech-stack.md.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
