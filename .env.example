# Copy this file to `.env` (never committed) and adjust the values.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Leave empty locally (falls back to SQLite automatically).
# In production, the Supabase (Postgres) connection URL -- see docs/03-tech-stack.md.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Leave SUPABASE_STORAGE_BUCKET empty locally (falls back to local filesystem storage).
# Set all of these to switch recipe photo uploads to Supabase Storage:
# - SUPABASE_PROJECT_REF: the subdomain in your project URL (https://<ref>.supabase.co)
# - SUPABASE_STORAGE_BUCKET: the public bucket name (e.g. recipe-photos)
# - SUPABASE_STORAGE_REGION: from Project Settings -> Storage -> S3 Connection
# - SUPABASE_STORAGE_ACCESS_KEY_ID / SUPABASE_STORAGE_SECRET_ACCESS_KEY: S3 Access Keys from the
#   same page (NOT the anon/service_role API keys)
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
